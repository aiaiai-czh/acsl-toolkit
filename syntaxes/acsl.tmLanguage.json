{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ACSL",
  "scopeName": "source.acsl",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#annotation-decoration"
    },
    {
      "include": "#multiword"
    },
    {
      "include": "#logic-types"
    },
    {
      "include": "#clauses"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#builtin-terms"
    },
    {
      "include": "#c-types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#unknown-backslash-identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.acsl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.acsl"
            }
          },
          "end": "(?:\"|(?=\\*/)|$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.acsl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.acsl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.acsl",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.acsl"
            }
          },
          "end": "(?:'|(?=\\*/)|$)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.acsl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.acsl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "annotation-decoration": {
      "patterns": [
        {
          "match": "^\\s*(@)(?=\\s|$)",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.acsl"
            }
          }
        }
      ]
    },
    "multiword": {
      "patterns": [
        {
          "name": "keyword.control.acsl",
          "match": "\\b(?:strong\\s+global\\s+invariant|strong\\s+type\\s+invariant|weak\\s+global\\s+invariant|weak\\s+type\\s+invariant|complete\\s+behaviors|disjoint\\s+behaviors|global\\s+invariant|loop\\s+allocates|loop\\s+invariant|type\\s+invariant|loop\\s+assigns|loop\\s+variant|loop\\s+frees)\\b"
        }
      ]
    },
    "logic-types": {
      "patterns": [
        {
          "name": "storage.type.acsl",
          "match": "(?<![A-Za-z0-9_])(?:\\\\list)(?![A-Za-z0-9_])"
        },
        {
          "name": "storage.type.acsl",
          "match": "\\b(?:allocation_status|rounding_mode|boolean|integer|real|sign|set)\\b"
        }
      ]
    },
    "clauses": {
      "patterns": [
        {
          "name": "keyword.control.acsl",
          "match": "\\b(?:terminates|allocates|behaviors|continues|decreases|invariant|behavior|complete|disjoint|requires|assigns|assumes|ensures|returns|variant|assert|breaks|exits|frees|loop)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.acsl",
          "match": "(?<![A-Za-z0-9_])(?:\\\\exists|\\\\forall|\\\\lambda|\\\\ghost|\\\\match|\\\\from|\\\\with|\\\\let|\\\\in)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.other.acsl",
          "match": "\\b(?:axiomatic|inductive|predicate|_Alignof|volatile|alignof|global|sizeof|strong|writes|admit|axiom|check|ghost|lemma|logic|model|reads|case|type|weak|for|as)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.acsl",
          "match": "(?<![A-Za-z0-9_])(?:\\\\pointer_comparable|\\\\is_minus_infinity|\\\\is_plus_infinity|\\\\object_pointer|\\\\valid_function|\\\\block_length|\\\\round_double|\\\\initialized|\\\\is_infinite|\\\\round_error|\\\\round_float|\\\\allocation|\\\\valid_read|\\\\allocable|\\\\base_addr|\\\\eq_double|\\\\ge_double|\\\\gt_double|\\\\is_finite|\\\\le_double|\\\\lt_double|\\\\ne_double|\\\\separated|\\\\dangling|\\\\eq_float|\\\\freeable|\\\\ge_float|\\\\gt_float|\\\\le_float|\\\\lt_float|\\\\ne_float|\\\\aligned|\\\\product|\\\\concat|\\\\is_NaN|\\\\length|\\\\offset|\\\\repeat|\\\\subset|\\\\acosh|\\\\asinh|\\\\atan2|\\\\atanh|\\\\exact|\\\\floor|\\\\fresh|\\\\hypot|\\\\inter|\\\\log10|\\\\numof|\\\\union|\\\\valid|\\\\acos|\\\\asin|\\\\atan|\\\\ceil|\\\\Cons|\\\\cosh|\\\\sign|\\\\sinh|\\\\sqrt|\\\\tanh|\\\\abs|\\\\cos|\\\\exp|\\\\log|\\\\max|\\\\min|\\\\nth|\\\\old|\\\\pow|\\\\sin|\\\\sum|\\\\tan|\\\\at)(?![A-Za-z0-9_])"
        },
        {
          "name": "support.function.acsl",
          "match": "\\b(?:real_of_double|real_of_float|pow)\\b"
        }
      ]
    },
    "builtin-terms": {
      "patterns": [
        {
          "name": "constant.language.acsl",
          "match": "(?<![A-Za-z0-9_])(?:\\\\exit_status|\\\\NearestAway|\\\\NearestEven|\\\\unallocated|\\\\automatic|\\\\Negative|\\\\Positive|\\\\register|\\\\dynamic|\\\\nothing|\\\\result|\\\\static|\\\\ToZero|\\\\empty|\\\\false|\\\\Down|\\\\null|\\\\true|\\\\Nil|\\\\pi|\\\\Up|\\\\e)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.language.acsl",
          "match": "\\b(?:LoopCurrent|LoopEntry|Here|Init|Post|Old|Pre)\\b"
        }
      ]
    },
    "c-types": {
      "patterns": [
        {
          "name": "storage.type.c.acsl",
          "match": "\\b(?:char|short|int|long|signed|unsigned|float|double|void|const|struct|union|enum)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.acsl",
          "match": "\\b0[xX](?:[0-9A-Fa-f]+(?:\\.[0-9A-Fa-f]*)?|\\.[0-9A-Fa-f]+)(?:[pP][+-]?[0-9]+)?[uUlLfF]*\\b"
        },
        {
          "name": "constant.numeric.acsl",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[uUlLfF]*(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.acsl",
          "match": "<==>|==>|\\&\\&|\\|\\||\\^\\^|!"
        },
        {
          "name": "keyword.operator.comparison.acsl",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.set.acsl",
          "match": "\\.\\.|\\*\\^|\\^"
        },
        {
          "name": "keyword.operator.arithmetic.acsl",
          "match": "-->|<-->|<<|>>|[-+*/%&|~]=?"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.acsl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "unknown-backslash-identifiers": {
      "patterns": [
        {
          "name": "variable.other.acsl",
          "match": "\\\\[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.acsl",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.group.acsl",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
